{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "audience_scope", "common", "groups", "assumptions", "unsupported", "notes", "send_at"],
  "properties": {
    "status": {"type": "string", "enum": ["ok", "partial", "unsupported", "rejected"]},
    "audience_scope": {"type": "string", "enum": ["filtered", "all"]},
    "common": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conditions"],
        "properties": {
          "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unsupported": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reason", "group"],
        "properties": {
          "text": {"type": "string"},
          "reason": {
            "type": "string",
            "enum": ["sequence", "aggregate", "ranking", "unknown_field", "absolute_date", "scheduling", "contradiction", "too_complex", "off_topic"]
          },
          "group": {"type": ["integer", "null"]}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "send_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
  },
  "$defs": {
    "condition": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field", "op", "values"],
          "properties": {
            "type": {"const": "attribute"},
            "field": {"const": "city"},
            "op": {"type": "string", "enum": ["in", "not_in"]},
            "values": {"type": "array", "items": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field", "op", "value"],
          "properties": {
            "type": {"const": "attribute"},
            "field": {"const": "age"},
            "op": {"type": "string", "enum": ["gte", "lte"]},
            "value": {"type": "integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event", "occurred", "within_days", "from", "to", "min_count", "then"],
          "properties": {
            "type": {"const": "event"},
            "event": {"type": "string", "enum": ["signup", "product_view", "add_to_cart", "purchase"]},
            "occurred": {"type": "boolean"},
            "within_days": {"type": ["integer", "null"]},
            "from": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
            "to": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
            "min_count": {"type": ["integer", "null"]},
            "then": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["event", "occurred"],
                  "properties": {
                    "event": {"type": "string", "enum": ["signup", "product_view", "add_to_cart", "purchase"]},
                    "occurred": {"type": "boolean"}
                  }
                },
                {"type": "null"}
              ]
            }
          }
        }
      ]
    }
  }
}
