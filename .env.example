# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Every variable is optional: defaults (shown here) live in
# backend/internal/platform/config.go.

# LLM: "mock" works without a key; "anthropic" requires ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Empty means the production API. Only for a proxy or a local fake server.
ANTHROPIC_BASE_URL=

# Postgres (matches docker-compose.yml for local development).
DATABASE_URL=postgres://scc:scc@localhost:5432/scc?sslmode=disable

# Listen addresses.
API_ADDR=:8080
MOCK_PROVIDER_ADDR=:8090

# Where the worker sends messages (the mock provider).
PROVIDER_URL=http://localhost:8090

# Worker (cmd/worker). Defaults live in backend/internal/delivery/worker.go.
# 95 msg/s per channel leaves headroom under the provider's 100/s limit.
WORKER_SEND_RATE=95
WORKER_CONCURRENCY=8
WORKER_LEASE=60s
# Worker's /healthz, /readyz and /metrics.
WORKER_ADDR=:8081

# Mock provider (cmd/mockprovider). Defaults live in
# backend/internal/mockprovider/config.go. Fault rates are shares of new
# requests in [0, 1]; their sum is at most 1.
MOCK_ERROR_RATE=0.05
MOCK_429_RATE=0.03
MOCK_ACCEPT_THEN_FAIL_RATE=0.02
MOCK_DELAY_MAX=50ms
MOCK_RATE_LIMIT=100
MOCK_RETRY_AFTER=1s
MOCK_SEED=42
