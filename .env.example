# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Every variable is optional: defaults (shown here) live in
# backend/internal/platform/config.go.

# LLM: "mock" works without a key; "anthropic" requires ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Postgres (matches docker-compose.yml for local development).
DATABASE_URL=postgres://scc:scc@localhost:5432/scc?sslmode=disable

# Listen addresses.
API_ADDR=:8080
MOCK_PROVIDER_ADDR=:8090
